# Provenance configuration
# Generated at Phase 0 (D-09). Never commit .env — only .env.example.

# Real GitHub source org (free) with ≥1 repo, ≥3 issues, ≥1 PR, issue-referencing commits
GITHUB_SOURCE_ORG=provenance-source-42
GITHUB_SOURCE_TOKEN=ghp_...<replace_with_pat>...

# Real GitHub target org (free, empty) — Executor (Phase 4) + Prover (Phase 6) point here
GITHUB_TARGET_ORG=provenance-target-42
GITHUB_TARGET_TOKEN=ghp_...<replace_with_pat>...

# GitHub repo migration scope
GITHUB_REPO_NAME=billing-svc

# Demo mode flag
DEMO_MODE=true

# Token budget per run (NFR-10, default 100k)
TOKEN_BUDGET=100000
